# ============================================================
# NuniCord Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ─── App Mode ───────────────────────────────────────────────
# multi = Discord-like multi-server mode
# single = Single community hub
NUNICORD_MODE=multi

# ─── Network ────────────────────────────────────────────────
# Port to expose the app on (host)
APP_PORT=3001

# Your domain (required for HTTPS with Caddy)
DOMAIN=localhost

# Caddy ACME email (for TLS cert registration)
CADDY_EMAIL=admin@yourdomain.com

# CORS allowed origins (comma-separated, * for all)
CORS_ORIGIN=*

# Trust reverse proxy headers (true if behind Caddy/nginx)
TRUST_PROXY=false

# ─── Security ────────────────────────────────────────────────
# REQUIRED: Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_64

# JWT token expiration
JWT_EXPIRES_IN=7d

# ─── Database ────────────────────────────────────────────────
POSTGRES_DB=nunicord
POSTGRES_USER=nunicord
# REQUIRED: Change this password
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# Expose postgres port on host (for debugging, use 127.0.0.1 to not expose externally)
POSTGRES_PORT_EXPOSE=127.0.0.1:5432

# ─── Redis ───────────────────────────────────────────────────
REDIS_PORT_EXPOSE=127.0.0.1:6379

# ─── File Storage ────────────────────────────────────────────
# Max upload size in megabytes
MAX_FILE_SIZE_MB=100

# S3/MinIO storage (leave empty to use local volume)
# AWS_S3_BUCKET=nunicord-uploads
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
# S3_ENDPOINT=http://minio:9000  # For MinIO

# ─── Push Notifications (VAPID) ──────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=your_public_key
# VAPID_PRIVATE_KEY=your_private_key
VAPID_EMAIL=admin@yourdomain.com

# ─── WebRTC TURN Server ──────────────────────────────────────
# Your server's external IP or hostname
TURN_HOST=localhost

# TURN credentials
TURN_USER=nunicord
TURN_PASSWORD=CHANGE_ME_turn_password
TURN_SECRET=CHANGE_ME_turn_secret
TURN_REALM=nunicord.local

# ─── OAuth (Optional) ─────────────────────────────────────────
# Google OAuth
# GOOGLE_CLIENT_ID=your_client_id
# GOOGLE_CLIENT_SECRET=your_client_secret

# GitHub OAuth
# GITHUB_CLIENT_ID=your_client_id
# GITHUB_CLIENT_SECRET=your_client_secret

# OAuth callback base URL
# OAUTH_CALLBACK_URL=https://yourdomain.com

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_MAX=1000

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info
# LOG_FILE=/var/log/nunicord/app.log

# ─── React App (Client-side) ─────────────────────────────────
# These are baked in at build time
REACT_APP_API_URL=/api
# REACT_APP_WS_URL=https://yourdomain.com
REACT_APP_MAX_FILE_SIZE_MB=100
# REACT_APP_TURN_HOST=your_turn_server
# REACT_APP_TURN_USER=nunicord
# REACT_APP_TURN_PASS=your_turn_password
# REACT_APP_OAUTH_GOOGLE=true
# REACT_APP_OAUTH_GITHUB=true
